PORT=3033
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=memoryguard
# Or set DATABASE_URL directly:
# DATABASE_URL=postgres://postgres:postgres@localhost/memoryguard?sslmode=disable

# Optional: host shown in Swagger "Try it out" (default = same origin as the UI)
# SWAGGER_HOST=localhost:3033

JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL=30m
REFRESH_TOKEN_TTL=168h
COOKIE_SECURE=false

# One-time: set role=admin for all existing users, then turn off
# MIGRATE_USERS_ROLE_ADMIN=true

# SMTP (Yandex) — used by POST /admin/send-code
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=myproject@yandex.ru
SMTP_PASSWORD=xxxxxxxxxxxxxxxx
# Optional; defaults to SMTP_USER
# SMTP_FROM=myproject@yandex.ru

# Shared memory node granted when a new user checks "sample cards" at registration.
SAMPLE_MEMORY_NODE_ID=5
